# Prana OPS Watcher — config/segredos (Story 2.1)
# Copiar para /home/ubuntu/.cockpit/watcher.env com permissão 600 (NUNCA no repo).
WATCHER_PORT=4100
WATCHER_DB=/home/ubuntu/.cockpit/watcher.db

# Camada 2 — regex + dedup (Story 2.3). Defaults já são sensatos; só ajuste
# se souber o que está fazendo.
WATCHER_LOGS_DIR=/home/ubuntu/.cockpit/logs
WATCHER_SCAN_MS=5000
WATCHER_STALL_MS=120000
WATCHER_DEDUP_WINDOW_MS=600000
WATCHER_DEDUP_LINES=5
WATCHER_LONG_MSG_MIN_LINES=5

# Camada 3 — classificador GPT 5.6 / delegate Azure OpenAI (Story 2.4).
# Sem as 3 variáveis abaixo preenchidas, a camada fica DESLIGADA
# silenciosamente (graceful degradation) — nada quebra, só não refina.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=
WATCHER_LLM_DAILY_CAP=200
WATCHER_LLM_TIMEOUT_MS=15000

# Notificação Telegram — a dor original do PRD morre aqui (Story 2.5).
# Sem as 2 variáveis abaixo preenchidas, a camada fica DESLIGADA
# silenciosamente. Ver watcher/DEPLOY.md para criar o bot (BotFather).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
WATCHER_TELEGRAM_RETRY_MS=30000
WATCHER_TELEGRAM_SWEEP_MS=30000
