{
  "name": "prana-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Prana OPS — terminal cockpit for managing VPS via SSH/tmux (Phase 1 MVP scaffolding)",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "server",
    "web",
    "watcher"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "start": "npm run build && tsx server/src/index.ts",
    "dev": "npm run build && tsx server/src/index.ts",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true,
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
